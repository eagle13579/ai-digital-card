# =============================================================================
# AI数智名片 — 后端环境变量配置模板
# =============================================================================
# 复制本文件为 .env 后填写真实值
#   cp .env.example .env
#
# 🔑 = 敏感密钥标记 — 这些值必须严格保密，切勿提交到版本控制系统
# ⚠️ = 生产环境建议使用环境变量或密钥管理服务
# =============================================================================

# ── 必填 ─────────────────────────────────────────────────────────────────────
# 🔑⚠️ JWT 签名密钥（256 位随机十六进制字符串）
# 生产环境务必使用强随机密钥： python -c "import secrets; print(secrets.token_hex(32))"
JWT_SECRET=your-256-bit-random-hex-key-here

# ── CORS ─────────────────────────────────────────────────────────────────────
# CORS 允许的来源（逗号分隔），生产环境只保留 https://liankebao.top 相关域名
CORS_ORIGINS=https://liankebao.top,https://api.liankebao.top,http://localhost:5173,http://localhost:8200

# ── 数据库 ───────────────────────────────────────────────────────────────────
# DATABASE_URL=sqlite+aiosqlite:///./data/digital_brochure.db
# DATABASE_URL=postgresql+asyncpg://postgres:postgres@localhost:5432/digital_brochure

# ── AI 能力 ──────────────────────────────────────────────────────────────────
# 🔑⚠️ DeepSeek API Key（必需供AI名片OCR+提取使用）
# DEEPSEEK_API_KEY=***
# DEEPSEEK_API_URL=https://api.deepseek.com/v1/chat/completions

# ── Redis ────────────────────────────────────────────────────────────────────
REDIS_HOST=localhost
REDIS_PORT=6379
# 🔑 Redis 密码（无密码留空）
# REDIS_PASSWORD=

# ═════════════════════════════════════════════════════════════════════════════
# 🔑 以下为敏感密钥区域 — 生产环境务必通过环境变量或密钥管理服务注入 🔑
# ═════════════════════════════════════════════════════════════════════════════

# ── CRM 集成 (Salesforce) ──────────────────────────────────────────────
# 🔑⚠️ Salesforce 凭据 — 全部缺失时自动降级为存根
# SF_INSTANCE_URL=https://your-instance.salesforce.com
# SF_CONSUMER_KEY=
# SF_CONSUMER_SECRET=
# SF_USERNAME=
# SF_PASSWORD=
# SF_SECURITY_TOKEN=

# ── CRM 集成 (HubSpot) ────────────────────────────────────────────────
# 🔑⚠️ HubSpot 凭据 — 缺失则降级存根
# HUBSPOT_ACCESS_TOKEN=
# HUBSPOT_BASE_URL=

# ── CRM 默认管道阶段配置 ──────────────────────────────────────────────
# CRM_DEFAULT_STAGES=[{"name":"潜在客户","color":"#d9d9d9","is_default":true},...]

# ── CRM 名片交换自动匹配 ─────────────────────────────────────────────
CRM_AUTO_MATCH_ON_EXCHANGE=true
CRM_AUTO_MATCH_ON_MATCH=true

# ── Sentry ───────────────────────────────────────────────────────────────────
# 🔑⚠️ Sentry DSN
# SENTRY_DSN=https://xxx@sentry.io/xxx

# ── 邮件服务 (SMTP) ──────────────────────────────────────────────────────────
# 🔑⚠️ SMTP 凭据 — 全部缺失时自动降级为日志输出
# SMTP_HOST=smtp.example.com
# SMTP_PORT=587
# SMTP_USER=noreply@aibizcard.com
# SMTP_PASSWORD=your-smtp-password
# SMTP_USE_TLS=true
# SMTP_FROM=noreply@aibizcard.com
# SMTP_FROM_NAME=AI数智名片

# ── 日历集成 (Zoom) ────────────────────────────────────────────────────────
# 🔑⚠️ Zoom API 凭据 — 全部缺失时自动降级为日志输出
# ZOOM_ACCOUNT_ID=
# ZOOM_CLIENT_ID=
# ZOOM_CLIENT_SECRET=
# ZOOM_API_KEY=
# ZOOM_API_SECRET=

# ── 日历集成 (腾讯会议) ────────────────────────────────────────────────────
# 🔑⚠️ 腾讯会议凭据 — 全部缺失时自动降级为日志输出
# TENCENT_MEETING_APP_ID=
# TENCENT_MEETING_SDK_ID=
# TENCENT_MEETING_SECRET=
# 详细配置说明见 docs/integrations/CALENDAR_INTEGRATION.md

# ── 三蛋蛋企业匹配引擎 (Transphee) ──────────────────────────────
# 外部 1000万 企业库匹配API (https://api.transphee.com:59226/tpmg/entcm)
# 用法: POST /api/transphee/match (SDK: app/services/transphee_client.py)
# AppID/Secret 由三蛋蛋提供; 每天 100 次查询配额 (北京时间0点重置)
# TRANSHEE_APP_ID=app_xxxxxxxxxxxxxxxx
# TRANSHEE_APP_SECRET=your-secret-here
# TRANSHEE_BASE_URL=https://api.transphee.com:59226/tpmg/entcm

# ── 飞书集成 ────────────────────────────────────────────────────────────────
# 🔑⚠️ 飞书应用凭据 — 全部缺失时飞书机器人降级为日志输出
# FEISHU_APP_ID=
# FEISHU_APP_SECRET=

# ═════════════════════════════════════════════════════════════════════════════
# 🔐 密钥加密配置 (SecretManager)
# ═════════════════════════════════════════════════════════════════════════════
# 生产环境通过此主密钥解密 .env.encrypted 中的真实密钥。
# 生成: python -c "import secrets; print(secrets.token_hex(32))"
# SECRET_MASTER_KEY=your-256-bit-random-hex-key-here

# ── 支付 (支付宝 / 微信支付) ──────────────────────────────────────────────
# 🔑⚠️ 支付凭据 — 全部缺失时: 支付宝下单返回「支付宝未配置」, 微信支付返回沙箱 mock 调起参数。
# 沙箱环境配置方式（无需真实商户资质）:
#   1. 支付宝开放平台 → 沙箱环境 (open.alipay.com → 沙箱应用): 获取沙箱 APP_ID / 应用私钥 / 支付宝公钥
#      （沙箱买家账号: 页面提供, 用于扫码/账号登录付款）
#   2. 微信支付: V2 沙箱商户号需在 https://pay.weixin.qq.com 申请; 沙箱密钥通过
#      sandboxnew/pay/getsignkey 接口获取（注意: 微信沙箱能力有限, 建议优先验证支付宝沙箱）
# 沙箱密钥与生产密钥不通用, 切换环境时必须成对替换。

# ── 支付沙箱总开关 ────────────────────────────────────────────────────────
# true  = 沙箱环境: 支付宝网关 openapi.alipaydev.com / 微信沙箱 api.mch.weixin.qq.com/sandboxnew
# false = 生产环境: 支付宝网关 openapi.alipay.com / 微信 api.mch.weixin.qq.com
PAYMENT_SANDBOX=false

# ── 支付宝 ────────────────────────────────────────────────────────────────
# 🔑⚠️ 支付宝应用 ID（沙箱应用与生产应用 ID 不同）
# ALIPAY_APP_ID=2021000000000000
# 🔑⚠️ 支付宝应用私钥（PEM 格式, 用 ---BEGIN PRIVATE KEY--- 包裹, 与支付宝公钥配对）
# ALIPAY_PRIVATE_KEY=-----BEGIN PRIVATE KEY-----\n...\n-----END PRIVATE KEY-----
# 🔑⚠️ 支付宝公钥（支付宝开放平台「密钥管理」中查看, 用于验证回调签名）
# ALIPAY_PUBLIC_KEY=-----BEGIN PUBLIC KEY-----\n...\n-----END PUBLIC KEY-----

# ── 微信支付 ──────────────────────────────────────────────────────────────
# 🔑⚠️ 微信小程序 AppID（微信支付 JSAPI 下单必填）
# WECHAT_MINI_APPID=wx0000000000000000
# 🔑⚠️ 微信商户号
# WECHAT_MCH_ID=1900000000
# 🔑⚠️ 微信支付 API V2 密钥（32位, 商户平台设置; 沙箱环境需用沙箱密钥）
# WECHAT_PAY_API_KEY=your-32-char-api-v2-key
# 🔑⚠️ 微信支付 API V3 密钥（32位, 用于 JSAPI 调起签名降级, 可选）
# WECHAT_PAY_V3_KEY=your-32-char-api-v3-key

