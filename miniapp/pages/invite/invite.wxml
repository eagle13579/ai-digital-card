<view class="page-container">
  <view class="header">
    <text class="title">AI数智名片</text>
    <text class="subtitle">1000人内测版</text>
  </view>
  <view class="badge">INVITE ONLY</view>
  <view class="code-section">
    <input class="code-input {{codeError ? 'error' : ''}}"
      type="text" maxlength="8" placeholder="输入8位邀请码"
      value="{{code}}" bindinput="onCodeInput" auto-focus />
    <text class="error-text" wx:if="{{codeError}}">{{codeError}}</text>
    <button class="verify-btn" bindtap="onVerify"
      disabled="{{loading || code.length !== 8}}">
      {{loading ? '验证中...' : '验证邀请码'}}
    </button>
    <view class="hint">
      <text>还没有邀请码？请联系管理员获取</text>
    </view>
  </view>
</view>
