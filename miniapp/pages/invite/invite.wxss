.page-container {
  padding: 40rpx; min-height: 100vh;
  background: linear-gradient(180deg, #1a1a2e 0%, #16213e 100%);
  display: flex; flex-direction: column; align-items: center;
}
.header { text-align: center; padding: 80rpx 0 20rpx; }
.title { font-size: 44rpx; font-weight: 700; color: #e0e0e0; }
.subtitle { font-size: 28rpx; color: #888; margin-top: 12rpx; display: block; }
.badge {
  background: linear-gradient(135deg, #ff6b6b, #ee5a24);
  color: #fff; font-size: 20rpx; font-weight: 700;
  padding: 6rpx 24rpx; border-radius: 20rpx;
  letter-spacing: 2rpx; margin: 20rpx 0 40rpx;
}
.code-section { width: 100%; padding: 0 40rpx; }
.code-input {
  width: 100%; height: 100rpx;
  background: rgba(255,255,255,0.08);
  border: 2rpx solid rgba(255,255,255,0.15);
  border-radius: 16rpx; font-size: 36rpx; color: #e0e0e0;
  text-align: center; letter-spacing: 8rpx;
}
.code-input.error { border-color: #ff4757; }
.error-text { color: #ff4757; font-size: 24rpx; margin-top: 10rpx; display: block; }
.verify-btn {
  width: 100%; height: 88rpx;
  background: linear-gradient(135deg, #667eea, #764ba2);
  border-radius: 44rpx; color: #fff;
  font-size: 32rpx; font-weight: 600; margin-top: 40rpx;
}
.verify-btn[disabled] { opacity: 0.5; }
.hint { text-align: center; margin-top: 40rpx; }
.hint text { font-size: 24rpx; color: #666; }
