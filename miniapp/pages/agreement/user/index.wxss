.page {
  width: 100%;
  height: 100vh;
  background-color: #1a1a2e;
  box-sizing: border-box;
}

.container {
  padding: 40rpx 36rpx;
  padding-bottom: 80rpx;
}

.title {
  display: block;
  font-size: 40rpx;
  font-weight: 700;
  color: #ffffff;
  text-align: center;
  margin-bottom: 48rpx;
}

.section {
  margin-bottom: 36rpx;
}

.section-title {
  display: block;
  font-size: 32rpx;
  font-weight: 600;
  color: #e0e0e0;
  margin-bottom: 20rpx;
}

.section-body {
  display: block;
  font-size: 28rpx;
  color: #b0b0b0;
  line-height: 1.8;
  margin-bottom: 16rpx;
  text-align: justify;
}
