<!--
  progressive_search/index.wxml — 渐进式人脉搜索页面

  两阶段可视化:
    Phase 1 (广度撒网): 标签/关键词匹配结果
    Phase 2 (深度挖掘): 多层关系扩展结果
  过渡条件可配置: 评分阈值/数量/模式
-->
<view class="page-container">

  <!-- 搜索栏 -->
  <view class="search-bar">
    <input class="search-input" placeholder="搜索人脉 (姓名/标签/公司)..." bindinput="onQueryInput" value="{{query}}" />
    <button class="search-btn" bindtap="onSearch" loading="{{searching}}">
      <text wx:if="{{!searching}}">🔍 搜索</text>
      <text wx:else>搜索中...</text>
    </button>
  </view>

  <!-- 配置面板 (可折叠) -->
  <view class="config-panel {{configExpanded ? 'expanded' : ''}}">
    <view class="config-header" bindtap="toggleConfig">
      <text>⚙️ 搜索配置</text>
      <text class="toggle-icon">{{configExpanded ? '▲' : '▼'}}</text>
    </view>
    <view wx:if="{{configExpanded}}" class="config-body">
      <view class="config-item">
        <text class="config-label">过渡模式</text>
        <picker mode="selector" range="{{modeOptions}}" value="{{modeIndex}}" bindchange="onModeChange">
          <view class="picker-value">{{modeOptions[modeIndex]}}</view>
        </picker>
      </view>
      <view class="config-item">
        <text class="config-label">广度撒网 (max_wide)</text>
        <slider min="5" max="50" step="5" value="{{maxWide}}" bindchange="onMaxWideChange" show-value />
      </view>
      <view class="config-item">
        <text class="config-label">深度挖掘层数 (depth)</text>
        <slider min="1" max="6" step="1" value="{{depth}}" bindchange="onDepthChange" show-value />
      </view>
      <view class="config-item">
        <text class="config-label">最低匹配分 (min_score)</text>
        <slider min="0" max="1" step="0.1" value="{{minScore * 10}}" bindchange="onMinScoreChange" show-value />
      </view>
    </view>
  </view>

  <!-- 过渡条件信息 -->
  <view wx:if="{{transitionInfo}}" class="transition-banner {{transitionInfo.should_deep ? 'ready' : 'waiting'}}">
    <view class="transition-title">
      <text>{{transitionInfo.should_deep ? '🚀 进入深度挖掘' : '⏳ 广度撒网中'}}</text>
    </view>
    <view class="transition-detail">
      <text>模式: {{transitionInfo.transition_mode}} | 结果: {{transitionInfo.total_wide}}条 | 最高分: {{transitionInfo.max_score}}</text>
    </view>
  </view>

  <!-- 空状态 -->
  <view wx:if="{{!searching && result === null}}" class="empty-state">
    <text class="empty-icon">🤝</text>
    <text class="empty-text">输入关键词，搜索人脉网络</text>
    <text class="empty-hint">两阶段智能搜索 · 广度撒网 → 深度挖掘</text>
  </view>

  <!-- 搜索结果 -->
  <view wx:if="{{result !== null}}" class="result-container">

    <!-- Phase 1: 广度撒网 -->
    <view class="phase-section">
      <view class="phase-header">
        <text class="phase-badge wide">Phase 1</text>
        <text class="phase-title">广度撒网</text>
        <text class="phase-count">{{result.phase1_wide.length}} 条结果</text>
      </view>
      <view wx:if="{{result.phase1_wide.length === 0}}" class="phase-empty">
        <text>未找到广度匹配结果</text>
      </view>
      <view wx:for="{{result.phase1_wide}}" wx:key="user_id" class="contact-card wide">
        <view class="contact-avatar">{{'👤'}}</view>
        <view class="contact-info">
          <view class="contact-name">{{item.name}}</view>
          <view class="contact-title">{{item.title || '未知职位'}}</view>
          <view class="contact-company">{{item.company || ''}}</view>
          <view class="contact-tags">
            <text wx:for="{{item.tags}}" wx:key="*this" class="tag">{{item}}</text>
          </view>
        </view>
        <view class="contact-score">
          <text class="score-value {{item.match_score >= 0.7 ? 'high' : item.match_score >= 0.4 ? 'mid' : 'low'}}">
            {{(item.match_score * 100).toFixed(0)}}%
          </text>
        </view>
      </view>
    </view>

    <!-- 过渡状态 -->
    <view wx:if="{{transitionInfo}}" class="transition-divider">
      <view class="divider-line"></view>
      <view class="divider-label">
        <text>{{transitionInfo.should_deep ? '⬇️ 过渡至深度挖掘' : '🤔 条件未满足'}}</text>
      </view>
      <view class="divider-line"></view>
    </view>

    <!-- Phase 2: 深度挖掘 -->
    <view class="phase-section" wx:if="{{result.phase2_deep.length > 0}}">
      <view class="phase-header">
        <text class="phase-badge deep">Phase 2</text>
        <text class="phase-title">深度挖掘</text>
        <text class="phase-count">{{result.phase2_deep.length}} 条结果</text>
      </view>
      <view wx:for="{{result.phase2_deep}}" wx:key="user_id" class="contact-card deep">
        <view class="contact-avatar">{{'🔗'}}</view>
        <view class="contact-info">
          <view class="contact-name">{{item.name}}</view>
          <view class="contact-title">{{item.title || '未知职位'}}</view>
          <view class="contact-company">{{item.company || ''}}</view>
          <view class="contact-tags">
            <text wx:for="{{item.tags}}" wx:key="*this" class="tag">{{item}}</text>
          </view>
          <view class="contact-path">
            <text class="path-label">连接路径: </text>
            <text wx:for="{{item.path}}" wx:key="*this" class="path-node">{{item}}</text>
          </view>
          <view class="contact-via" wx:if="{{item.via}}">
            <text class="via-label">通过: {{item.via}}</text>
            <text class="trust-score" wx:if="{{item.trust_score !== undefined}}">信任分: {{(item.trust_score * 100).toFixed(0)}}%</text>
          </view>
        </view>
        <view class="contact-score">
          <text class="score-value {{item.match_score >= 0.7 ? 'high' : item.match_score >= 0.4 ? 'mid' : 'low'}}">
            {{(item.match_score * 100).toFixed(0)}}%
          </text>
        </view>
      </view>
    </view>

    <!-- 搜索统计 -->
    <view class="search-stats">
      <text class="stats-label">搜索耗时: {{result.elapsed_ms}}ms | 共 {{result.total_found}} 条结果</text>
      <text class="stats-id">ID: {{result.search_id}}</text>
    </view>
  </view>

  <!-- 加载状态 -->
  <view wx:if="{{searching && result === null}}" class="loading-state">
    <view class="loading-animation">
      <view class="phase-indicator wide-active">🌐 广度撒网...</view>
      <view class="phase-indicator {{transitionReady ? 'deep-active' : 'dim'}}">🔍 深度挖掘...</view>
    </view>
  </view>

  <!-- 错误状态 -->
  <view wx:if="{{error}}" class="error-banner">
    <text>{{error}}</text>
    <button class="retry-btn" bindtap="onSearch">重试</button>
  </view>

</view>
