<view class="login-page">
  <view class="login-header">
    <text class="login-logo">AI数智名片</text>
    <text class="login-slogan">让每一次连接都有价值</text>
  </view>

  <view class="feature-list">
    <view class="feature-item">
      <view class="feature-icon">📇</view>
      <text class="feature-text">智能名片创建</text>
    </view>
    <view class="feature-item">
      <view class="feature-icon">🤝</view>
      <text class="feature-text">信任网络连接</text>
    </view>
    <view class="feature-item">
      <view class="feature-icon">🎯</view>
      <text class="feature-text">AI精准匹配</text>
    </view>
  </view>

  <view class="login-form">
    <button class="btn-wechat" open-type="getUserInfo" bindgetuserinfo="onGetUserInfo" loading="{{loading}}" disabled="{{loading}}">
      <view class="wechat-icon">
        <image src="/images/wechat.png" mode="aspectFit" style="width:20px;height:20px;" />
      </view>
      <text class="wechat-text">微信一键登录</text>
    </button>

    <view class="login-alternative" bindtap="skipLogin">暂不登录，先看看</view>
  </view>

  <view class="login-footer">
    <text>登录即表示同意</text>
    <text class="link" bindtap="goAgreement">《用户协议》</text>
    <text class="link" bindtap="goPrivacy">《隐私政策》</text>
  </view>
</view>
